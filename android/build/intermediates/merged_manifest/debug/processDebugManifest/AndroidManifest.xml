<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.sessionwidget" >

    <uses-sdk android:minSdkVersion="24" />

    <application>
        <receiver
            android:name="expo.modules.sessionwidget.SessionWidgetReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/session_widget_info" />
        </receiver>

        <service
            android:name="expo.modules.sessionwidget.SessionWidgetHeadlessService"
            android:exported="false" />
    </application>

</manifest>